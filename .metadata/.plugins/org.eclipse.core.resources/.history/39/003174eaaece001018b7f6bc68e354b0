#include "hal_adc12.h"

void hal_ADC12Init()
{
    ADC12CTL0 &= ~ADC12ENC;             // ### disable conversion -> must later on be enabled ###
    ADC12CTL0 |= ADC12SHT0_11;          // on rising edge from timer B0
    ADC12CTL0 |= ADC12REFON;            // using Vref
    ADC12CTL0 |= ADC12ON;               // turning ADC on

    ADC12CTL1 |= ADC12SHS_2;        // hopefully this is the timerB0, idk where to find the corresponding timers
    ADC12CTL1 |= ADC12SHP;        // SAMPCON signal from sample timer
    ADC12CTL1 |= ADC12DIV_3;        // prescaler 3 cause I want 1,6us
    ADC12CTL1 |= ADC12SSEL_3;       // smckl ich mag nicht mehr
    ADC12CTL1 |= ADC12CONSEQ_3;     // repeated sequence

    //ADC12CTL2 |= ADC12TCOFF;        // temp sensor off
    ADC12CTL2 |= ADC12RES_2;        // 12 bit resolution

    ADC12MCTL0 = ADC12INCH_0 | ADC12SREF_1;        // Kanal A0, Referenz = Vref+
    ADC12MCTL1 = ADC12INCH_1 | ADC12SREF_1;        // Kanal A1, Referenz = Vref+
    ADC12MCTL2 = ADC12INCH_2 | ADC12SREF_1;        // Kanal A2, Referenz = Vref+
    ADC12MCTL3 = ADC12INCH_3 | ADC12SREF_1 | ADC12EOS; // Kanal A3, End of Sequence

    ADC12IE |= (ADC12IE0 | ADC12IE1 | ADC12IE2 | ADC12IE3);            // enable interrupt
    ADC12CTL0 |= ADC12ENC;
    ADC12CTL0 |= ADC12SC;
}

#pragma vector = ADC12_VECTOR
__interrupt void ADC12_ISR(void)
{
    // Gesampelte Daten aus den ADC12MEMx-Regs auslesen
    ADC12Data.Data.Sensor.SensorFront = ADC12MEM2;
    ADC12Data.Data.Sensor.SensorLeft = ADC12MEM1;
    ADC12Data.Data.Sensor.SensorRight = ADC12MEM0;
    ADC12Data.Data.Sensor.VBat = ADC12MEM3;

    // ADC12Data.Status.B.ADCrdy = 1 setzen
    ADC12Data.Status.B.ADCrdy = 1;
}
