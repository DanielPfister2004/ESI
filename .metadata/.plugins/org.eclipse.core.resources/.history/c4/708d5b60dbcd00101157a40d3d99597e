#include "hal_timerB0.h"
#include "hal_usciB1.h"
#include "hal_LCD.h"

extern USCIB1_SPICom LCD;

// is a 120Hz timer
void timerB0_init()
{
    TB0CTL |= TBSSEL__SMCLK;
    TB0CTL |= ID__8;
    TB0CTL |= MC__UP;
    TB0CCTL0 |= OUTMOD_2;       // toggle/reset

    TB0CCR0 = 522; // 2.5MHz / (8*5 * 120Hz + 1)    -> f~119,9616Hz
    TB0EX0 |= TBIDEX__6;  // extension
    TB0CCTL0 |= CCIE;  // activating interrupt
    LCD.Status.TxSuc = 1;
}



// ### old timer functions are in LAB6 ###

#pragma vector=TIMER0_B0_VECTOR
__interrupt void TimerB0_ISR(void)
{

    TB0CCTL0 &= ~CCIFG;   // Clear interrupt flag
}

